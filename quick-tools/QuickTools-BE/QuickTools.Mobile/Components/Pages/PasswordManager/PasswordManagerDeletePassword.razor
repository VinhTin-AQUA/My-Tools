<div class="password-popup-overlay fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4"
     @onclick="Close">
    <div class="password-popup-panel flex max-h-[calc(100vh-2rem)] w-full max-w-[28rem] flex-col overflow-hidden rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)] shadow-2xl"
         role="dialog"
         aria-modal="true"
         aria-labelledby="delete-password-title"
         @onclick:stopPropagation>
        <div class="flex items-center justify-between gap-3 border-b border-[color:var(--color-border)] px-4 py-3">
            <h2 id="delete-password-title"
                class="m-0 text-base font-semibold text-[color:var(--color-text-primary)]">
                Delete password
            </h2>

            <button type="button"
                    class="pm-icon-btn"
                    aria-label="Close"
                    disabled="@_isDeleting"
                    @onclick="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="max-h-[calc(100vh-9rem)] overflow-y-auto p-4">
            <div class="flex flex-col gap-5">
                <div class="flex items-start gap-3">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--color-primary-soft)] text-[color:var(--color-error)]"
                          aria-hidden="true">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </span>

                    <div class="min-w-0">
                        <p class="m-0 text-sm text-[color:var(--color-text-primary)]">
                            Are you sure you want to delete this password?
                        </p>

                        <p class="m-0 mt-1 text-xs text-[color:var(--color-text-secondary)]">
                            This action cannot be undone.
                        </p>
                    </div>
                </div>

                <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
                    <button type="button"
                            class="pm-btn pm-btn-outlined w-full sm:w-auto"
                            disabled="@_isDeleting"
                            @onclick="Close">
                        Cancel
                    </button>

                    <button type="button"
                            class="pm-btn pm-btn-danger w-full sm:w-auto"
                            disabled="@(_isDeleting || PasswordId is null)"
                            @onclick="ConfirmDelete">
                        @if (_isDeleting)
                        {
                            <i class="fa-solid fa-spinner fa-spin"></i>
                            <span>Delete</span>
                        }
                        else
                        {
                            <i class="fa-solid fa-trash"></i>
                            <span>Delete</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
