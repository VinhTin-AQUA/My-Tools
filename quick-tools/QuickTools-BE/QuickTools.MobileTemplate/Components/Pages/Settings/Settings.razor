@page "/settings"

<div class="min-h-screen bg-[var(--color-background)]">
    <div class="mx-auto w-full max-w-5xl px-4 py-4 sm:px-6 sm:py-8 lg:px-8">

        <!-- Page Header -->
        <div class="mb-6 sm:mb-8">
            <h1 class="text-xl font-semibold tracking-tight text-[var(--color-text-primary)] sm:text-2xl lg:text-3xl">
                Settings
            </h1>
            <p class="mt-1.5 text-sm leading-5 text-[var(--color-text-secondary)] sm:text-base">
                Manage your application preferences and personalize your experience.
            </p>
        </div>

        <!-- Settings Menu - Mobile Optimized -->
        <div class="space-y-3 sm:space-y-4">
            @foreach (var item in SettingMenus)
            {
                <NavLink href="@item.Url"
                         class="group flex items-center gap-4 rounded-xl border border-[var(--color-border)] 
                                bg-[var(--color-surface)] px-4 py-4 transition-all duration-200
                                active:scale-[0.98] active:bg-[var(--color-background)]
                                hover:border-[var(--color-primary)] hover:shadow-sm
                                sm:px-5 sm:py-5">

                    <!-- Icon -->
                    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg 
                                bg-[var(--color-primary-soft)] text-[var(--color-primary)]
                                transition-colors duration-200 group-hover:bg-[var(--color-primary)] 
                                group-hover:text-white sm:h-12 sm:w-12">
                        <i class="@item.Icon text-base sm:text-lg"></i>
                    </div>

                    <!-- Content -->
                    <div class="min-w-0 flex-1">
                        <h2 class="text-sm font-semibold text-[var(--color-text-primary)] 
                                   transition-colors duration-200 group-hover:text-[var(--color-primary)]
                                   sm:text-base">
                            @item.Title
                        </h2>
                        <p class="mt-0.5 text-xs text-[var(--color-text-secondary)] line-clamp-2 
                                  sm:text-sm">
                            @item.Description
                        </p>
                    </div>

                    <!-- Arrow Indicator -->
                    <div class="shrink-0 text-[var(--color-text-secondary)] transition-all duration-200 
                                group-hover:text-[var(--color-primary)] group-hover:translate-x-0.5">
                        <i class="fa-solid fa-chevron-right text-xs sm:text-sm"></i>
                    </div>

                </NavLink>
            }
        </div>

    </div>
</div>
