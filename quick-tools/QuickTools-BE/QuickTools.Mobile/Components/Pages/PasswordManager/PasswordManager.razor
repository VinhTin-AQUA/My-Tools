@page "/password-manager"
@using QuickTools.Mobile.Components.Shared

<div class="passwords-page min-h-screen">
    <div class="mx-auto flex w-full max-w-2xl flex-col gap-4 p-4 pb-24 sm:gap-6 sm:p-6 sm:pb-28 lg:p-8 lg:pb-32">
        <!-- =====================================================
             HEADER
        ====================================================== -->
        <header class="grid grid-cols-[1fr_auto_1fr] items-center gap-2">
            <!-- Back -->
            <div class="justify-self-start">
                <button type="button"
                        class="pm-back-button"
                        aria-label="Quay lại trang trước"
                        @onclick="GoBack">
                    <i class="fa-solid fa-arrow-left"></i>
                </button>
            </div>

            <!-- Title -->
            <h1 class="passwords-text m-0 truncate text-center text-lg font-semibold tracking-tight sm:text-xl">
                Passwords
            </h1>

            <!-- Actions -->
            <div class="flex items-center justify-self-end gap-1">
                <button type="button"
                        class="pm-icon-btn"
                        aria-label="Reload passwords"
                        @onclick="OnReload">
                    <i class="fa-solid fa-rotate-right"></i>
                </button>

                <button type="button"
                        class="pm-icon-btn"
                        aria-label="Open menu"
                        @onclick="OpenHeaderMenu">
                    <i class="fa-solid fa-bars"></i>
                </button>
            </div>
        </header>

        <!-- =====================================================
             PASSWORD LIST
        ====================================================== -->
        <section class="passwords-surface overflow-hidden rounded-xl border" aria-label="Saved passwords">
            @if (_isLoading)
            {
                <div class="flex items-center justify-center px-4 py-16">
                    <Loader />
                </div>
            }
            else if (_passwords.Count == 0)
            {
                <div class="flex flex-col items-center justify-center gap-2 px-4 py-16 text-center">
                    <div class="passwords-empty-icon flex h-14 w-14 items-center justify-center rounded-full"
                         aria-hidden="true">
                        <i class="fa-solid fa-key text-xl"></i>
                    </div>

                    <p class="passwords-text m-0 text-sm font-medium">No passwords yet</p>

                    <p class="passwords-text-muted m-0 text-xs">
                        Your saved accounts will appear here.
                    </p>
                </div>
            }
            else
            {
                @foreach (var item in _passwords)
                {
                    <article @key="item.Id"
                             class="passwords-card flex items-center gap-3 border-b px-3 py-3 last:border-b-0 sm:gap-4 sm:px-4">
                        <!-- Account icon -->
                        <div class="passwords-icon flex h-10 w-10 shrink-0 items-center justify-center rounded-lg"
                             aria-hidden="true">
                            <i class="fa-solid fa-key text-base"></i>
                        </div>

                        <!-- Account name -->
                        <div class="pm-tooltip-group relative min-w-0 flex-1">
                            <p class="passwords-text m-0 truncate text-sm font-medium sm:text-base">
                                @item.AccountName
                            </p>

                            <span class="pm-tooltip" role="tooltip">@item.AccountName</span>
                        </div>

                        <!-- Context menu -->
                        <button type="button"
                                class="pm-icon-btn pm-icon-btn-sm shrink-0"
                                aria-label="More actions for @item.AccountName"
                                @onclick="e => OpenItemMenu(e, item)">
                            <i class="fa-solid fa-ellipsis-vertical"></i>
                        </button>
                    </article>
                }
            }
        </section>
    </div>

    <!-- =====================================================
         DROPDOWN MENUS
    ====================================================== -->
    @if (_showHeaderMenu)
    {
        <div class="fixed inset-0 z-40" @onclick="CloseMenus"></div>

        <div class="pm-menu" style="@MenuStyle(_headerMenuX, _headerMenuY)" role="menu">
            <button type="button" class="pm-menu-item" role="menuitem" @onclick="OnSetKey">
                <i class="fa-solid fa-key"></i>
                <span>Set Key</span>
            </button>

            <button type="button" class="pm-menu-item" role="menuitem" @onclick="OnSetUrl">
                <i class="fa-solid fa-link"></i>
                <span>Set URL</span>
            </button>

            <button type="button" class="pm-menu-item" role="menuitem" @onclick="OnBackup">
                <i class="fa-solid fa-file-export"></i>
                <span>Backup</span>
            </button>
        </div>
    }

    @if (_showItemMenu)
    {
        <div class="fixed inset-0 z-40" @onclick="CloseMenus"></div>

        <div class="pm-menu" style="@MenuStyle(_itemMenuX, _itemMenuY)" role="menu">
            <button type="button" class="pm-menu-item" role="menuitem" @onclick="OnViewPassword">
                <i class="fa-solid fa-eye"></i>
                <span>View Password</span>
            </button>

            <button type="button" class="pm-menu-item" role="menuitem" @onclick="OnEditPassword">
                <i class="fa-solid fa-pen"></i>
                <span>Edit</span>
            </button>

            <button type="button" class="pm-menu-item" role="menuitem" @onclick="OnDeletePassword">
                <i class="fa-solid fa-trash"></i>
                <span>Delete</span>
            </button>
        </div>
    }

    <!-- =====================================================
         FIXED ADD BUTTON
    ====================================================== -->
    <div class="fixed right-4 bottom-4 z-20 sm:right-6 sm:bottom-6">
        <button type="button"
                class="pm-fab"
                aria-label="Add password"
                @onclick="OpenAddPassword">
            <i class="fa-solid fa-plus"></i>
        </button>
    </div>

    @if (_isBackingUp)
    {
        <div class="fixed inset-0 z-[60] flex items-center justify-center bg-black/50 p-4"
             role="status"
             aria-live="polite">
            <div class="flex w-full max-w-xs flex-col items-center gap-4 rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-6 shadow-2xl">
                <Loader />

                <p class="m-0 text-sm font-medium text-[color:var(--color-text-primary)]">
                    Backing up passwords...
                </p>
            </div>
        </div>
    }

    <!-- =====================================================
         POPUPS
    ====================================================== -->
    @if (_showSetKey)
    {
        <PasswordManagerSetKey ExistingKey="_key"
                                VisibleChange="OnSetKeyVisibleChange"
                                KeySaved="OnKeySaved" />
    }

    @if (_showSetUrl)
    {
        <PasswordManagerSetUrl CurrentUrl="_url"
                               VisibleChange="OnSetUrlVisibleChange"
                               UrlSaved="OnUrlSaved" />
    }

    @if (_showViewPassword)
    {
        <PasswordManagerViewPassword Password="_selectedPassword"
                                     VisibleChange="OnViewPasswordVisibleChange" />
    }

    @if (_showEditPassword)
    {
        <PasswordManagerEditPassword Password="_selectedPassword"
                                     VisibleChange="OnEditPasswordVisibleChange"
                                     PasswordUpdated="OnPasswordUpdated" />
    }

    @if (_showDeletePassword)
    {
        <PasswordManagerDeletePassword PasswordId="@(_selectedPassword?.Id)"
                                       VisibleChange="OnDeletePasswordVisibleChange"
                                       PasswordDeleted="OnPasswordDeleted" />
    }

    @if (_showAddPassword)
    {
        <PasswordManagerAddPassword VisibleChange="OnAddPasswordVisibleChange"
                                    PasswordAdded="OnPasswordAdded" />
    }
</div>
