<div class="password-popup-overlay fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4"
     @onclick="Close">
    <div class="password-popup-panel flex max-h-[calc(100vh-2rem)] w-full max-w-[32rem] flex-col overflow-hidden rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)] shadow-2xl"
         role="dialog"
         aria-modal="true"
         aria-labelledby="view-password-title"
         @onclick:stopPropagation>
        <div class="flex items-center justify-between gap-3 border-b border-[color:var(--color-border)] px-4 py-3">
            <h2 id="view-password-title"
                class="m-0 text-base font-semibold text-[color:var(--color-text-primary)]">
                Password details
            </h2>

            <button type="button"
                    class="pm-icon-btn"
                    aria-label="Close"
                    @onclick="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="max-h-[calc(100vh-9rem)] overflow-y-auto p-4">
            @if (Fields.Count > 0)
            {
                <div class="flex flex-col gap-3">
                    @foreach (var field in Fields)
                    {
                        <div class="flex items-start gap-3 rounded-lg border border-[color:var(--color-border)] p-3">
                            <div class="min-w-0 flex-1">
                                <p class="m-0 text-xs font-medium text-[color:var(--color-text-secondary)]">
                                    @field.Label
                                </p>

                                <p class="m-0 mt-1 text-sm break-all whitespace-pre-wrap text-[color:var(--color-text-primary)]">
                                    @DisplayValue(field)
                                </p>
                            </div>

                            @if (field.Label == "Password")
                            {
                                <button type="button"
                                        class="pm-icon-btn shrink-0"
                                        aria-label="@(_showPassword ? "Hide password" : "Show password")"
                                        aria-pressed="@(_showPassword ? "true" : "false")"
                                        @onclick="TogglePasswordVisibility">
                                    <i class="@(_showPassword ? "fa-solid fa-eye-slash" : "fa-solid fa-eye")"></i>
                                </button>
                            }

                            <button type="button"
                                    class="pm-icon-btn shrink-0"
                                    aria-label="Copy @field.Label"
                                    @onclick="() => CopyValue(field)">
                                <i class="fa-regular fa-copy"></i>
                            </button>
                        </div>
                    }

                    <div class="flex justify-end pt-1">
                        <button type="button"
                                class="pm-btn pm-btn-outlined w-full sm:w-auto"
                                @onclick="Close">
                            Close
                        </button>
                    </div>
                </div>
            }
            else
            {
                <p class="m-0 text-sm text-[color:var(--color-text-secondary)]">
                    No password selected.
                </p>
            }
        </div>
    </div>
</div>
