@using Microsoft.AspNetCore.Components.Web

<div class="password-popup-overlay fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
    <div class="password-popup-panel flex max-h-[calc(100vh-2rem)] w-full max-w-[30rem] flex-col overflow-hidden rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)] shadow-2xl"
         role="dialog"
         aria-modal="true"
         aria-labelledby="edit-password-title">
        <div class="flex items-center justify-between gap-3 border-b border-[color:var(--color-border)] px-4 py-3">
            <h2 id="edit-password-title"
                class="m-0 text-base font-semibold text-[color:var(--color-text-primary)]">
                Edit password
            </h2>

            <button type="button"
                    class="pm-icon-btn"
                    aria-label="Close"
                    disabled="@_isSaving"
                    @onclick="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="max-h-[calc(100vh-9rem)] overflow-y-auto p-4">
            <form class="flex flex-col gap-4" novalidate @onsubmit="OnSubmit" @onsubmit:preventDefault>
                <div class="flex flex-col gap-1.5">
                    <label for="edit-account-name"
                           class="text-sm font-medium text-[color:var(--color-text-primary)]">
                        Account Name
                    </label>

                    <input id="edit-account-name"
                           type="text"
                           autocomplete="off"
                           class="pm-input w-full"
                           @bind="_accountName"
                           @bind:event="oninput"
                           @onblur="() => _accountNameTouched = true" />

                    @if (AccountNameError is not null)
                    {
                        <small class="text-xs text-[color:var(--color-error)]">
                            @AccountNameError
                        </small>
                    }
                </div>

                <div class="flex flex-col gap-1.5">
                    <label for="edit-user-name"
                           class="text-sm font-medium text-[color:var(--color-text-primary)]">
                        Username
                    </label>

                    <input id="edit-user-name"
                           type="text"
                           autocomplete="username"
                           class="pm-input w-full"
                           @bind="_userName"
                           @bind:event="oninput"
                           @onblur="() => _userNameTouched = true" />

                    @if (UserNameError is not null)
                    {
                        <small class="text-xs text-[color:var(--color-error)]">
                            @UserNameError
                        </small>
                    }
                </div>

                <div class="flex flex-col gap-1.5">
                    <label for="edit-password"
                           class="text-sm font-medium text-[color:var(--color-text-primary)]">
                        Password
                    </label>

                    <div class="relative">
                        <input id="edit-password"
                               type="@(_showPassword ? "text" : "password")"
                               autocomplete="new-password"
                               class="pm-input w-full pr-11"
                               @bind="_password"
                               @bind:event="oninput"
                               @onblur="() => _passwordTouched = true" />

                        <button type="button"
                                class="pm-icon-btn pm-icon-btn-sm absolute top-1/2 right-1 -translate-y-1/2"
                                aria-label="@(_showPassword ? "Hide password" : "Show password")"
                                aria-pressed="@(_showPassword ? "true" : "false")"
                                @onclick="TogglePasswordVisibility">
                            <i class="@(_showPassword ? "fa-solid fa-eye-slash" : "fa-solid fa-eye")"></i>
                        </button>
                    </div>

                    @if (PasswordError is not null)
                    {
                        <small class="text-xs text-[color:var(--color-error)]">
                            @PasswordError
                        </small>
                    }
                </div>

                <div class="flex flex-col gap-1.5">
                    <label for="edit-confirm-password"
                           class="text-sm font-medium text-[color:var(--color-text-primary)]">
                        Confirm Password
                    </label>

                    <div class="relative">
                        <input id="edit-confirm-password"
                               type="@(_showConfirmPassword ? "text" : "password")"
                               autocomplete="new-password"
                               class="pm-input w-full pr-11"
                               @bind="_confirmPassword"
                               @bind:event="oninput"
                               @onblur="() => _confirmPasswordTouched = true" />

                        <button type="button"
                                class="pm-icon-btn pm-icon-btn-sm absolute top-1/2 right-1 -translate-y-1/2"
                                aria-label="@(_showConfirmPassword ? "Hide password" : "Show password")"
                                aria-pressed="@(_showConfirmPassword ? "true" : "false")"
                                @onclick="ToggleConfirmPasswordVisibility">
                            <i class="@(_showConfirmPassword ? "fa-solid fa-eye-slash" : "fa-solid fa-eye")"></i>
                        </button>
                    </div>

                    @if (ConfirmPasswordError is not null)
                    {
                        <small class="text-xs text-[color:var(--color-error)]">
                            @ConfirmPasswordError
                        </small>
                    }
                </div>

                <div class="flex flex-col gap-1.5">
                    <label for="edit-note"
                           class="text-sm font-medium text-[color:var(--color-text-primary)]">
                        Note
                        <span class="font-normal text-[color:var(--color-text-secondary)]">(optional)</span>
                    </label>

                    <textarea id="edit-note"
                              rows="3"
                              class="pm-input w-full resize-y"
                              @bind="_note"></textarea>
                </div>

                <div class="flex flex-col-reverse gap-2 pt-1 sm:flex-row sm:justify-end">
                    <button type="button"
                            class="pm-btn pm-btn-outlined w-full sm:w-auto"
                            disabled="@_isSaving"
                            @onclick="Close">
                        Cancel
                    </button>

                    <button type="submit"
                            class="pm-btn pm-btn-primary w-full sm:w-auto"
                            disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <i class="fa-solid fa-spinner fa-spin"></i>
                            <span>Save</span>
                        }
                        else
                        {
                            <i class="fa-solid fa-check"></i>
                            <span>Save</span>
                        }
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
