<div class="password-popup-overlay fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4"
     @onclick="Close">
    <div class="password-popup-panel flex max-h-[calc(100vh-2rem)] w-full max-w-[28rem] flex-col overflow-hidden rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)] shadow-2xl"
         role="dialog"
         aria-modal="true"
         aria-labelledby="set-key-title"
         @onclick:stopPropagation>
        <div class="flex items-center justify-between gap-3 border-b border-[color:var(--color-border)] px-4 py-3">
            <h2 id="set-key-title"
                class="m-0 text-base font-semibold text-[color:var(--color-text-primary)]">
                Set key
            </h2>

            <button type="button"
                    class="pm-icon-btn"
                    aria-label="Close"
                    disabled="@_isSaving"
                    @onclick="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="max-h-[calc(100vh-9rem)] overflow-y-auto p-4">
            <form class="flex flex-col gap-4" novalidate @onsubmit="OnSubmit" @onsubmit:preventDefault>
                @if (!string.IsNullOrEmpty(ExistingKey))
                {
                    <div class="flex flex-col gap-1.5">
                        <label for="set-key-old"
                               class="text-sm font-medium text-[color:var(--color-text-primary)]">
                            Old Key
                        </label>

                        <div class="relative">
                            <input id="set-key-old"
                                   type="@(_showOldKey ? "text" : "password")"
                                   autocomplete="current-password"
                                   class="pm-input w-full pr-11"
                                   @bind="_oldKey"
                                   @bind:event="oninput"
                                   @onblur="() => _oldKeyTouched = true" />

                            <button type="button"
                                    class="pm-icon-btn pm-icon-btn-sm absolute top-1/2 right-1 -translate-y-1/2"
                                    aria-label="@(_showOldKey ? "Hide old key" : "Show old key")"
                                    aria-pressed="@(_showOldKey ? "true" : "false")"
                                    @onclick="ToggleOldKeyVisibility">
                                <i class="@(_showOldKey ? "fa-solid fa-eye-slash" : "fa-solid fa-eye")"></i>
                            </button>
                        </div>

                        @if (OldKeyError is not null)
                        {
                            <small class="text-xs text-[color:var(--color-error)]">
                                @OldKeyError
                            </small>
                        }
                    </div>
                }

                <div class="flex flex-col gap-1.5">
                    <label for="set-key-new"
                           class="text-sm font-medium text-[color:var(--color-text-primary)]">
                        New Key
                    </label>

                    <div class="relative">
                        <input id="set-key-new"
                               type="@(_showNewKey ? "text" : "password")"
                               autocomplete="new-password"
                               class="pm-input w-full pr-11"
                               @bind="_newKey"
                               @bind:event="oninput"
                               @onblur="() => _newKeyTouched = true" />

                        <button type="button"
                                class="pm-icon-btn pm-icon-btn-sm absolute top-1/2 right-1 -translate-y-1/2"
                                aria-label="@(_showNewKey ? "Hide new key" : "Show new key")"
                                aria-pressed="@(_showNewKey ? "true" : "false")"
                                @onclick="ToggleNewKeyVisibility">
                            <i class="@(_showNewKey ? "fa-solid fa-eye-slash" : "fa-solid fa-eye")"></i>
                        </button>
                    </div>

                    @if (NewKeyError is not null)
                    {
                        <small class="text-xs text-[color:var(--color-error)]">
                            @NewKeyError
                        </small>
                    }
                </div>

                <div class="flex flex-col gap-1.5">
                    <label for="set-key-confirm"
                           class="text-sm font-medium text-[color:var(--color-text-primary)]">
                        Confirm New Key
                    </label>

                    <div class="relative">
                        <input id="set-key-confirm"
                               type="@(_showConfirmNewKey ? "text" : "password")"
                               autocomplete="new-password"
                               class="pm-input w-full pr-11"
                               @bind="_confirmNewKey"
                               @bind:event="oninput"
                               @onblur="() => _confirmNewKeyTouched = true" />

                        <button type="button"
                                class="pm-icon-btn pm-icon-btn-sm absolute top-1/2 right-1 -translate-y-1/2"
                                aria-label="@(_showConfirmNewKey ? "Hide confirm new key" : "Show confirm new key")"
                                aria-pressed="@(_showConfirmNewKey ? "true" : "false")"
                                @onclick="ToggleConfirmNewKeyVisibility">
                            <i class="@(_showConfirmNewKey ? "fa-solid fa-eye-slash" : "fa-solid fa-eye")"></i>
                        </button>
                    </div>

                    @if (ConfirmNewKeyError is not null)
                    {
                        <small class="text-xs text-[color:var(--color-error)]">
                            @ConfirmNewKeyError
                        </small>
                    }
                </div>

                <div class="flex flex-col-reverse gap-2 pt-1 sm:flex-row sm:justify-end">
                    <button type="button"
                            class="pm-btn pm-btn-outlined w-full sm:w-auto"
                            disabled="@_isSaving"
                            @onclick="Close">
                        Cancel
                    </button>

                    <button type="submit"
                            class="pm-btn pm-btn-primary w-full sm:w-auto"
                            disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <i class="fa-solid fa-spinner fa-spin"></i>
                            <span>Save</span>
                        }
                        else
                        {
                            <i class="fa-solid fa-check"></i>
                            <span>Save</span>
                        }
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
